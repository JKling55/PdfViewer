<Window x:Class="PdfViewer.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password required"
        Icon="Assets/app.ico"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=PasswordBox}">
    <StackPanel Margin="20" MinWidth="360" MaxWidth="460">

        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Foreground="Firebrick" Margin="0,6,0,0"
                   Text="The password is incorrect. Please try again." Visibility="Collapsed" />

        <PasswordBox x:Name="PasswordBox" Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
