<Window x:Class="PdfViewer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Klingeling PdfViewer"
        Icon="Assets/app.ico"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="24" MinWidth="360" MaxWidth="440">

        <StackPanel Orientation="Horizontal">
            <!-- Bitmap shown in the About window -->
            <Image Source="Assets/logo.png" Width="72" Height="72" Margin="0,0,16,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Klingeling PdfViewer" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Foreground="Gray" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>
        <Separator Margin="0,12" Background="Transparent" Height="1" />

        <TextBlock TextWrapping="Wrap"
                   Text="A lightweight PDF viewer built with C# and WPF (.NET 8). It supports multiple documents in tabs, a table of contents, full-text search, zoom and printing." />

        <TextBlock TextWrapping="Wrap"
                   Text="&#x0a;&#x0a;© 2026 John Kling&#x0a;&#x0a;Donations are welcome via PayPal johnkling@gmx.de" />

        <TextBlock Text="Built with" FontWeight="SemiBold" Margin="0,16,0,4" />
        <TextBlock TextWrapping="Wrap">
            <Run Text="Docnet.Core" FontWeight="SemiBold" /><Run Text=" – page rendering (PDFium)" />
            <LineBreak />
            <Run Text="PdfPig" FontWeight="SemiBold" /><Run Text=" – text and bookmark extraction" />
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Licenses…" Width="90" Margin="0,0,8,0" Click="Licenses_Click" />
            <Button Content="OK" Width="80" IsDefault="True" IsCancel="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
